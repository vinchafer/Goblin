# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Service Role key (SECRET — never expose to browser)
# Same page as above → "service_role" key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM encryption of BYOK keys
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create OAuth App: https://github.com/settings/developers
# Callback URL: https://api.justgoblin.com/api/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3001/api/github/callback

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs — geo-tiered (Build / Pro / Power × Tier 1/2/3).
# TIER1 = High income, TIER2 = Upper-middle, TIER3 = Lower-middle + Low.
# Display amounts live in apps/api/src/config/geo-pricing.ts (PLAN_PRICES);
# these env vars must point at the matching Stripe prices.
# TIER1 ids are required (checkout fallback); TIER2/3 optional.
STRIPE_PRICE_BUILD_TIER1=price_build_t1_id
STRIPE_PRICE_BUILD_TIER2=price_build_t2_id
STRIPE_PRICE_BUILD_TIER3=price_build_t3_id
STRIPE_PRICE_PRO_TIER1=price_pro_t1_id
STRIPE_PRICE_PRO_TIER2=price_pro_t2_id
STRIPE_PRICE_PRO_TIER3=price_pro_t3_id
STRIPE_PRICE_POWER_TIER1=price_power_t1_id
STRIPE_PRICE_POWER_TIER2=price_power_t2_id
STRIPE_PRICE_POWER_TIER3=price_power_t3_id

# ─── Web Push / VAPID ────────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT=mailto:hi@justgoblin.com

# ─── Storage (Backblaze B2, EU eu-central-003 / S3-compatible) ───────────────
# Create bucket: https://www.backblaze.com/b2/cloud-storage.html
STORAGE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
STORAGE_KEY=your-access-key-id
STORAGE_SECRET=your-application-key
STORAGE_BUCKET=goblin-projects
STORAGE_REGION=auto

# ─── App URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
PORT=3001

# ─── Optional: Free-API Pool (Layer 2 model routing) ────────────────────────
# Leave empty to disable the free tier routing
# GOOGLE_FREE_API_KEY=AIza...          # https://aistudio.google.com/app/apikey
# GROQ_FREE_API_KEY=gsk_...            # https://console.groq.com/keys
# CEREBRAS_FREE_API_KEY=csk-...        # https://cloud.cerebras.ai
# OPENROUTER_FREE_API_KEY=sk-or-...    # https://openrouter.ai/keys

# ─── Optional: LiteLLM Proxy ────────────────────────────────────────────────
# When set, Goblin routes all chat completions through LiteLLM first.
# Falls back to direct provider APIs if LiteLLM is not reachable.
# LITELLM_BASE_URL=http://localhost:4000     # e.g. http://litellm.your-domain.com
# LITELLM_API_KEY=sk-your-litellm-master-key

# ─── Supabase auth-mail hook (AKT 1 · U3) ────────────────────────────────────
# Secret generated by Supabase Dashboard → Authentication → Hooks → Send Email.
# UNSET is the safe default and the kill switch: without it POST /api/auth/email-hook
# refuses every call, so Supabase keeps sending its own templates and nothing breaks.
# Setup + verification steps: docs/AUTH_EMAIL_HOOK_SETUP.md
SUPABASE_AUTH_HOOK_SECRET=

# ─── Support Email (Resend) ──────────────────────────────────────────────────
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Where escalation emails go (support inbox)
SUPPORT_EMAIL_TO=support@justgoblin.com

# Sender address (must be on a verified Resend domain — the root justgoblin.com)
SUPPORT_EMAIL_FROM=Goblin Support <support@justgoblin.com>

# ─── Optional: Admin + Internal ─────────────────────────────────────────────
# Enables /api/admin routes
ADMIN_API_KEY=your-secret-admin-key

# Used for internal server-to-server calls (build status updates, etc.)
CRON_SECRET=your-secret-cron-key

# ─── Optional: Error Monitoring (Sentry) ────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=production
# LOG_LEVEL=info    # debug | info | warn | error

# ─── Optional: Better-Stack Heartbeat ───────────────────────────────────────
# Heartbeat URL pinged after each successful eval suite run.
# BETTERSTACK_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/XYZ

# ─── Optional: Admin gate ───────────────────────────────────────────────────
# Comma-separated Supabase user IDs allowed to access /admin/api/* endpoints.
# ADMIN_USER_IDS=uuid-1,uuid-2

# ─── Optional: Goblin-bundled models (Layer 2, API-first) ───────────────────
# Server-side-keyed inference (inverse of BYOK). Default OFF — while unset, the
# router never selects Layer 2 (code path unreachable). Sourced from a US wholesale
# per-token inference API; never name the provider on a public/marketing surface.
# See infra/GOBLIN_HOSTED_ACTIVATION.md.
#
# SECRET: the wholesale key lives ONLY in the Railway env var DEEPINFRA_API_KEY.
# Locally keep a PLACEHOLDER (empty or "set-in-railway") — never the real key.
# GOBLIN_HOSTED_API=true
# DEEPINFRA_API_KEY=set-in-railway
# GOBLIN_HOSTED_BASE_URL=https://api.deepinfra.com/v1/openai   # optional; this is the default
# GOBLIN_HOSTED_MODEL_EFFICIENT=deepseek-ai/DeepSeek-V3.2      # Goblin Swift (default tier)
# GOBLIN_HOSTED_MODEL_PREMIUM=moonshotai/Kimi-K2.6            # Goblin Forge (premium tier)
# GOBLIN_TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo       # dictation fallback (C1); DeepInfra Whisper via the same key
#
# Investor-gated model-mapping endpoint (GET /api/investor/models). Shared secret
# that lets the PITCH deployment fetch the real Swift/Forge → underlying-model
# mapping server-to-server (sent in the `x-investor-token` header). Dedicated,
# narrowly-scoped token — NOT the admin key. Railway-only; placeholder locally.
# Unset → the endpoint denies every request (fail closed).
# INVESTOR_MODELS_TOKEN=set-in-railway

# ─── Optional: Eval Runner ──────────────────────────────────────────────────
# Goblin's own provider keys (NOT user BYOK) for daily eval suite.
# EVAL_ANTHROPIC_KEY=sk-ant-...
# EVAL_OPENAI_KEY=sk-proj-...
# EVAL_GEMINI_KEY=AIza...
# EVAL_GROQ_KEY=gsk_...
# Random 32-char hex secret for authenticating cron/manual eval triggers.
# Generate: openssl rand -hex 32
# EVAL_CRON_SECRET=

# ─── Optional: WAVE-H concurrency admission (H4) ────────────────────────────
# The single-box process caps how many agent runs may execute AT ONCE, so a flood
# can't exhaust the box or trip the shared circuit breaker (Code-DD N-1/N-6). These
# are founder knobs — generous defaults, no real user is throttled at current scale.
# Global ceiling on simultaneous agent runs in this process. 0 = disable the cap.
# AGENT_GLOBAL_MAX_CONCURRENT=50
# Per-user simultaneous agent runs. Generous for humans, a ceiling against fan-out.
# 0 = disable. Complements (does not replace) AGENT_RUNS_PER_HOUR.
# AGENT_MAX_CONCURRENT_PER_USER=2
# Retry-After (seconds) sent to a shed run; the client shows honest copy + auto-retries.
# AGENT_CAPACITY_RETRY_AFTER_SEC=8

# ─── Optional: abandoned-turn bound for the standalone chat (FINAL-POLISH U1) ──
# A client disconnect no longer aborts a chat turn — locking the phone used to throw
# away an answer the user had already paid for. This is what bounds a turn whose reader
# has gone away: the chat twin of AGENT_MAX_RUNTIME_MS. Default 120000 (2 min), far above
# a normal turn. Lower it to tighten the cost of abandoned turns.
# CHAT_MAX_RUNTIME_MS=120000

# ─── AKT 2 · hosted apps: Cloudflare + the ops plane ─────────────────────────
# These are the names `apps/api/src/services/cf-deploy.ts` reads, character for
# character. It is a closed list — `CF_ENV_VARS` in that file — and the health
# probe reports exactly these by name:
#
#     GET /api/ops/health  →  checks.env.missing
#
# That endpoint is the arbiter when the Railway dashboard and the running process
# disagree. It reports PRESENCE only, never a value. A variable set on a different
# Railway service, or saved before a redeploy finished, is absent as far as the
# API is concerned no matter how it looks in the dashboard.
#
# Every value is read at call time and unwrapped: surrounding whitespace and ONE
# pair of quotes are stripped (`lib/env-value.ts`), so a value pasted out of a
# .env file or a doc code block works. Two pairs, or one stray quote, do not —
# that is a different mistake and it stays visible.
#
# Cloudflare account id: Dashboard → any zone → right sidebar → Account ID.
# CF_ACCOUNT_ID=
# API token (SECRET). Dashboard → My Profile → API Tokens. Scopes the router
# provisioning needs: Account → Workers Scripts:Edit, Workers KV Storage:Edit,
# Workers R2 Storage:Edit; Zone (justgoblin.app) → Zone:Read, DNS:Edit,
# Workers Routes:Edit.
# CF_API_TOKEN=
# R2 S3 credentials (SECRET). Dashboard → R2 → Manage API tokens.
# CF_R2_ACCESS_KEY_ID=
# CF_R2_SECRET_ACCESS_KEY=
# R2 S3 endpoint — bare origin, NO bucket path segment. A trailing `/goblin-apps`
# has broken this before (see docs/GOBLIN_OPS_MASTER_PLAN_16_PHASES.md).
# A bucket in a jurisdiction needs its jurisdiction endpoint: for the EU that is
# https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# CF_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# The bucket's NAME — not its id, not its S3 URL. Dashboard → R2 → the bucket.
# Bound into the router Worker as `APPS`; empty here means the router is not
# uploaded at all and POST /api/ops/router/provision says so by this name.
# CF_R2_BUCKET=goblin-apps
# The bucket's JURISDICTION, when it has one. Dashboard → R2 → the bucket → its
# Location. `eu` for an EU-restricted bucket; UNSET for a normal one.
#
# This is not cosmetic and it is not optional for a jurisdiction bucket. An EU
# bucket lives in a SEPARATE namespace from the default one, so a Worker binding
# that does not name the jurisdiction asks for a bucket that is not there, and
# Cloudflare answers `10085 R2 bucket 'goblin-apps' not found` — about a bucket
# that plainly exists and that the S3 client is reading and writing at the same
# moment. The token is not the problem when that happens.
#
# Setting it for a bucket WITHOUT a jurisdiction causes the same error in reverse.
# A jurisdiction cannot be changed after a bucket is created, so this variable is
# what moves — never the bucket.
#
# Accepted: eu, fedramp, fedramp-high. Anything else REFUSES the router upload
# rather than quietly binding the default namespace — that would be a silent
# data-residency change, and the privacy page names R2-in-the-EU as a fact.
# Separate from CF_R2_ENDPOINT above: the endpoint carries the jurisdiction for
# the S3 path, this carries it for the Worker binding. Both must agree.
# CF_R2_JURISDICTION=eu
# The KV namespace ID (32-char hex) — not its title. Dashboard → Storage &
# Databases → KV → the namespace. Bound into the router Worker as `ROUTES`.
# CF_KV_NAMESPACE_ID=
# Per-call timeout against Cloudflare, ms. Default 10000.
# CF_TIMEOUT_MS=10000
# compatibility_date stamped on uploaded Workers. Fixed, not "today", so a deploy
# is reproducible. Default 2025-01-01.
# CF_WORKER_COMPAT_DATE=2025-01-01

# The apps domain. `{name}.{OPS_APPS_DOMAIN}` is a published app's address.
# OPS_APPS_DOMAIN=justgoblin.app
# Where the apps domain's apex redirects, and the base of the AUP link on the
# suspended page. Default https://justgoblin.com.
# OPS_SITE_URL=https://justgoblin.com
# The kill switch for the whole /api/ops surface. Anything but the literal
# `true` (quotes tolerated) is off, and off means /api/ops answers 404.
# OPS_HOSTING_ENABLED=false
# Comma-separated allowlists. Unset admits nobody — fail-closed by design.
# OPS_BETA_ACCOUNTS=
# OPS_FOUNDER_ACCOUNTS=
